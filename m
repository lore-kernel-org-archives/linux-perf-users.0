/* val4.c  2012-12-07 09:26

   Reference executable for demonstrating perf call graph anomaly.

   The expected distribution of time is approximately
     main   total 100% self  0%
     fn2    total 100% self 50%
     fn1    total  50% self 50%

   Language -std=gnu99 (with gcc-specific attributes).
   Original versions tested:  x86_64, gcc 4.7.2, mainline kernel 3.6.7.
*/

#ifndef INNERLOOP
#define INNERLOOP 100000000
#endif

#include <inttypes.h>
#include <math.h>
#include <stdio.h>

uint64_t accumulator=1;
double   adder=0;

void fn1() __attribute__((noinline));
void fn2() __attribute__((noinline));

void fn1() {
  for (uint64_t looper=0; looper<INNERLOOP; ++looper)
    adder += M_PI*3, accumulator = accumulator*3 + adder;
}

void fn2() {
  for (uint64_t looper=0; looper<INNERLOOP; ++looper)
    adder += M_PI*3, accumulator = accumulator*3 + adder;
  fn1();
}

int main() {
  fn2();
  printf ("%" PRIu64 " %f\n", accumulator, adder);
  return 0;
}

